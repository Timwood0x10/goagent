evolution_best.json
examples/autonomous-evolution/autonomous-evolution

Ares_docs/ares.yaml
/ares.yaml

# Example run configs hold real LLM keys once edited — never track them.
examples/*/ares.yaml

# Agent context dir (rounds/, generated by the coding agent)
.context/

# Compiled demo binaries (48MB+; build on demand via go run)
/26-runtime-scheduling-demo
/examples/26-runtime-scheduling-demo/26-runtime-scheduling-demo
/30-introspect-panel-demo
/examples/30-introspect-panel-demo/30-introspect-panel-demo

# Compiled ares serve/demo binary (60MB+; build on demand via go build)
/ares
/graph_demo

# Coverage profiles are local build artifacts (multi-MB, regenerated by
# `go test -coverprofile`); never track them.
cover.out
*.out
coverage.html
